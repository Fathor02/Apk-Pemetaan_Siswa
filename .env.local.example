# SUPABASE CONFIGURATION
# Dapatkan kredensial ini di dashboard Supabase: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ADMIN AUTHENTICATION (server-only, jangan pakai prefix NEXT_PUBLIC_)
# Password login Admin (mode penyimpanan database)
ADMIN_PASSWORD=admin123
# Secret untuk menandatangani cookie sesi admin (HMAC). Ganti dengan string acak panjang.
ADMIN_SESSION_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter